---
import BaseLayout from "../layouts/BaseLayout.astro";
import StatStrip from "../components/StatStrip.astro";
import { getSiteStats, getLatestBatch } from "../lib/batches";
import { withBase } from "../lib/url";

const stats = await getSiteStats();
const latest = await getLatestBatch();
---

<BaseLayout title="About">
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-b from-noir-900 via-noir-900 to-noir-950">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,_rgba(171,55,34,0.18),_transparent_60%)]"></div>
    <div class="relative mx-auto max-w-4xl px-5 py-20 text-center sm:py-28">
      <img src={withBase("/images/logo.png")} alt="PGDBA logo" class="mx-auto mb-6 h-20 w-20" width="80" height="80" />
      <h1 class="font-display text-5xl font-semibold tracking-tight text-noir-50 sm:text-6xl">
        Post Graduate Diploma in <span class="text-brand-400">Business Analytics</span><span class="text-brand-500">.</span>
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-balance text-lg text-noir-200">
        A joint program of the Indian Statistical Institute Kolkata, IIM Calcutta, and IIT
        Kharagpur — training analytics leaders through a rigorous, data-driven curriculum.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href={withBase("/experiences/")}
          class="rounded-full bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-700"
        >
          Read Interview Experiences
        </a>
        <a
          href={withBase(`/experiences/${latest.data.batch}/`)}
          class="rounded-full border border-noir-700 bg-noir-800/60 px-6 py-3 text-sm font-semibold text-noir-50 transition-colors hover:border-brand-400 hover:text-brand-300"
        >
          Latest batch: {latest.data.batch}
        </a>
      </div>
    </div>
  </section>

  <!-- Institutes banner -->
  <section class="border-b border-noir-700 bg-noir-950">
    <img
      src={withBase("/images/3_institute_logo.jpg")}
      alt="Indian Statistical Institute Kolkata, Indian Institute of Management Calcutta, and Indian Institute of Technology Kharagpur"
      class="mx-auto max-h-64 w-full object-contain"
    />
  </section>

  <!-- What is PGDBA -->
  <section class="mx-auto max-w-4xl px-5 py-16">
    <h2 class="font-display text-3xl font-semibold text-ink-900">What is PGDBA<span class="text-brand-600">.</span></h2>
    <div class="prose prose-ink mt-4 max-w-none text-ink-700">
      <!--
        TODO: replace with official program copy. Placeholder drafted from public knowledge of
        the program structure so the page isn't empty during development — must be reviewed
        and signed off before launch.
      -->
      <p>
        The Post Graduate Diploma in Business Analytics (PGDBA) is a full-time, 24-month
        program jointly offered by three of India's premier institutes: the
        <strong>Indian Statistical Institute (ISI), Kolkata</strong>, the
        <strong>Indian Institute of Management (IIM) Calcutta</strong>, and the
        <strong>Indian Institute of Technology (IIT) Kharagpur</strong>. Students spend time at
        all three campuses, combining statistical rigor, management perspective, and
        engineering/technology depth into a single analytics curriculum.
      </p>
      <p>
        Admission is highly selective — a written test followed by a personal interview
        conducted by faculty from all three institutes. This site exists to help aspirants
        understand what that interview actually looks like, in the words of students who've
        been through it.
      </p>
    </div>
  </section>

  <!-- Stats -->
  <section class="mx-auto max-w-4xl px-5 pb-16">
    <StatStrip
      stats={[
        { value: String(stats.batchCount), label: "Batches covered" },
        { value: `${stats.recordCount}+`, label: "Interview experiences" },
        { value: `${stats.firstYear}–present`, label: "Years archived" },
        { value: stats.lastBatch ?? "", label: "Most recent batch" },
      ]}
    />
  </section>

  <!-- Why this site -->
  <section class="bg-noir-950 px-5 py-16">
    <div class="mx-auto max-w-4xl rounded-3xl bg-white p-8 shadow-sm sm:p-12">
      <h2 class="font-display text-3xl font-semibold text-ink-900">Why this site exists<span class="text-brand-600">.</span></h2>
      <p class="mt-4 text-ink-700">
        This is an alumni-run, free resource for PGDBA aspirants — a rebuild of interview
        experiences originally collected on the program's old WordPress site. Every batch from
        2015-17 through {latest.data.batch} is archived here, organized and searchable by year,
        so future applicants can prepare with a clear sense of what to expect.
      </p>
      <a href={withBase("/experiences/")} class="mt-6 inline-block font-semibold text-brand-700 hover:text-brand-800">
        Browse all interview experiences →
      </a>
    </div>
  </section>
</BaseLayout>
