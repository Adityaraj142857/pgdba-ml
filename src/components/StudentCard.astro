---
import type { InterviewRecord } from "../lib/schema";

interface Props {
  record: InterviewRecord;
}
const { record: r } = Astro.props;

const quickFacts = [r.ugCollege, r.gradStream, r.workExBackground].filter(Boolean);

const questionSections: Array<{ label: string; value?: string }> = [
  { label: "Work-ex / profile questions", value: r.questions.general },
  { label: "Maths & statistics questions", value: r.questions.mathStats },
  { label: "Coding / ML questions", value: r.questions.coding },
  { label: "GK & current affairs questions", value: r.questions.gk },
  { label: "Logical reasoning / puzzles", value: r.questions.logical },
].filter((s) => s.value);

const infoGrid: Array<{ label: string; value?: string }> = [
  { label: "Undergraduate college", value: r.ugCollege },
  { label: "Background", value: r.ugBackground },
  { label: "Graduation year", value: r.gradYear },
  { label: "Stream", value: r.gradStream },
  { label: "Post-graduation", value: [r.pgCollege, r.pgStream].filter(Boolean).join(", ") || undefined },
  { label: "Work experience", value: [r.workExMonths, r.workExBackground].filter(Boolean).join(" · ") || undefined },
  { label: "Organizations", value: r.organizations },
  { label: "Prior coding experience", value: r.priorCoding },
  { label: "Resources — written exam", value: r.resourcesWritten },
  { label: "Resources — interview", value: r.resourcesInterview },
  { label: "Alternate programs", value: r.alternatePrograms },
  { label: "Offers received", value: r.offers },
].filter((f) => f.value);
---

<article class="rounded-2xl border border-ink-100 bg-white shadow-sm transition-shadow hover:shadow-md">
  <div class="flex flex-wrap items-start justify-between gap-3 p-5">
    <div>
      <h3 class="font-display text-lg font-semibold text-ink-900">{r.name}</h3>
      {quickFacts.length > 0 && (
        <p class="mt-1 text-sm text-ink-500">{quickFacts.join(" · ")}</p>
      )}
      {r.linkUrl && (
        <a
          href={r.linkUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-2 inline-flex items-center gap-1 text-xs font-medium text-brand-700 hover:text-brand-800"
        >
          View profile ↗
        </a>
      )}
    </div>
    <div class="flex flex-wrap gap-2">
      {r.writtenScore !== undefined && (
        <span class="rounded-full bg-tint-blue px-3 py-1 text-xs font-semibold text-ink-800">
          Written: {r.writtenScore}
        </span>
      )}
      {r.preInterviewScore !== undefined && (
        <span class="rounded-full bg-tint-blue px-3 py-1 text-xs font-semibold text-ink-800">
          Pre-interview: {r.preInterviewScore}
        </span>
      )}
      {r.interviewDifficulty !== undefined && (
        <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700">
          Difficulty: {r.interviewDifficulty}/5
        </span>
      )}
    </div>
  </div>

  {(infoGrid.length > 0 || questionSections.length > 0 || r.tips) && (
    <details class="group border-t border-ink-100">
      <summary class="flex cursor-pointer list-none items-center justify-between px-5 py-3 text-sm font-semibold text-brand-700 hover:bg-brand-50/60">
        <span>Read full interview experience</span>
        <svg class="h-4 w-4 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>

      <div class="space-y-5 px-5 pb-6 pt-1">
        {infoGrid.length > 0 && (
          <dl class="grid grid-cols-1 gap-x-6 gap-y-3 sm:grid-cols-2">
            {infoGrid.map((f) => (
              <div>
                <dt class="text-xs font-medium uppercase tracking-wide text-ink-500">{f.label}</dt>
                <dd class="mt-0.5 whitespace-pre-line text-sm text-ink-800">{f.value}</dd>
              </div>
            ))}
          </dl>
        )}

        {questionSections.length > 0 && (
          <div class="space-y-4 border-t border-ink-100 pt-4">
            {questionSections.map((s) => (
              <div>
                <h4 class="text-xs font-semibold uppercase tracking-wide text-brand-700">{s.label}</h4>
                <p class="mt-1 whitespace-pre-line text-sm leading-relaxed text-ink-800">{s.value}</p>
              </div>
            ))}
          </div>
        )}

        {r.tips && (
          <div class="rounded-xl bg-brand-50 p-4">
            <h4 class="text-xs font-semibold uppercase tracking-wide text-brand-700">Tips for aspirants</h4>
            <p class="mt-1 whitespace-pre-line text-sm leading-relaxed text-ink-800">{r.tips}</p>
          </div>
        )}
      </div>
    </details>
  )}
</article>
