---
import type { BatchEntry } from "../lib/batches";
import { withBase } from "../lib/url";

interface Props {
  batches: BatchEntry[];
  activeBatch: string;
}
const { batches, activeBatch } = Astro.props;
---

<nav aria-label="Choose batch year" class="border-b border-noir-700 bg-noir-900">
  <div class="mx-auto max-w-6xl overflow-x-auto px-5">
    <ul class="flex min-w-max gap-1 py-3">
      {batches.map((b) => (
        <li>
          <a
            href={withBase(`/experiences/${b.data.batch}/`)}
            class:list={[
              "block whitespace-nowrap rounded-full px-4 py-2 text-sm font-medium transition-colors",
              b.data.batch === activeBatch
                ? "bg-brand-600 text-white shadow-sm"
                : "text-noir-200 hover:bg-noir-800 hover:text-brand-300",
            ]}
            aria-current={b.data.batch === activeBatch ? "page" : undefined}
          >
            {b.data.batch}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>
