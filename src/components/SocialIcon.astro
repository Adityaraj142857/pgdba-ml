---
interface Props {
  name: "linkedin" | "instagram" | "youtube" | "magazine";
  class?: string;
}
const { name, class: className = "h-6 w-6" } = Astro.props;
---

{name === "linkedin" && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class={className}>
    <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.61 0 4.28 2.38 4.28 5.47v6.27zM5.34 7.43a2.07 2.07 0 11.01-4.14 2.07 2.07 0 010 4.14zM7.12 20.45H3.56V9h3.56v11.45z" />
  </svg>
)}
{name === "instagram" && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class={className}>
    <rect x="3" y="3" width="18" height="18" rx="5" />
    <circle cx="12" cy="12" r="4.2" />
    <circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none" />
  </svg>
)}
{name === "youtube" && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class={className}>
    <path d="M22 12c0-2.1-.2-3.6-.5-4.6-.3-.9-1-1.6-1.9-1.9C18 5 12 5 12 5s-6 0-7.6.5c-.9.3-1.6 1-1.9 1.9C2.2 8.4 2 9.9 2 12s.2 3.6.5 4.6c.3.9 1 1.6 1.9 1.9C6 19 12 19 12 19s6 0 7.6-.5c.9-.3 1.6-1 1.9-1.9.3-1 .5-2.5.5-4.6zM10 15.5v-7l6 3.5-6 3.5z" />
  </svg>
)}
{name === "magazine" && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class={className}>
    <path d="M4 4.5h12a2 2 0 012 2V19a1.5 1.5 0 001.5 1.5H6a2 2 0 01-2-2v-14z" />
    <path d="M18 4.5v14a2 2 0 002 2" />
    <path d="M7.5 8h6M7.5 11.5h6M7.5 15h3.5" />
  </svg>
)}
