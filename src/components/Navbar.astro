---
const navItems = [
  { href: "/", label: "About" },
  { href: "/experiences/", label: "Interview Experiences" },
];
const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-40 border-b border-ink-100 bg-paper/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3">
    <a href="/" class="flex items-center gap-3">
      <img src="/images/logo.png" alt="PGDBA logo" class="h-10 w-10" width="40" height="40" />
      <span class="font-display text-lg font-semibold tracking-tight text-ink-900">PGDBA</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="peer hidden" />
    <label
      for="nav-toggle"
      class="cursor-pointer rounded-md p-2 text-ink-700 hover:bg-ink-100 md:hidden"
      aria-label="Toggle menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </label>

    <nav
      class="absolute left-0 right-0 top-full hidden flex-col gap-1 border-b border-ink-100 bg-paper px-5 py-3 peer-checked:flex md:static md:flex md:flex-row md:gap-2 md:border-none md:bg-transparent md:p-0"
    >
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            "rounded-md px-3 py-2 text-sm font-medium transition-colors",
            isActive(item.href)
              ? "bg-brand-50 text-brand-700"
              : "text-ink-700 hover:bg-ink-50 hover:text-ink-900",
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
